# ── Free/mock mode (no API key needed) ────────────────────────────────────────
MOCK_LLM=false
# Embedding backend: "openai" (needs key) or "huggingface" (free, runs locally)
EMBEDDING_BACKEND=openai

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Azure OpenAI (alternative to OpenAI) ──────────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-01

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=enterprise-rag
PINECONE_ENVIRONMENT=us-east-1

# ── Vector store: "faiss" (local, free) or "pinecone" (cloud) ─────────────────
VECTOR_STORE_BACKEND=faiss
FAISS_INDEX_PATH=./data/faiss_index

# ── RAG settings ──────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
MAX_TOKENS=1024
TEMPERATURE=0.1

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=enterprise-rag

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
